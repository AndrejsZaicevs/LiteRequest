// JSON with {{variable}} placeholders.
//
// Identical to @lezer/json except that a `{{name}}` template token is a
// valid value and a valid property name, so the parser (and everything
// built on it: bracket matching, folding, highlighting) does not choke on
// request bodies that reference variables.

@top JsonText { value }

value { True | False | Null | Number | String | Object | Array | Variable }

String { string }
Object { "{" list<Property>? "}" }
Array  { "[" list<value>? "]" }

Property { PropertyName ":" value }
PropertyName { string | Variable }

list<item> { item ("," item)* }

@tokens {
  True  { "true" }
  False { "false" }
  Null  { "null" }

  Number { '-'? int frac? exp?  }
  int  { '0' | $[1-9] @digit* }
  frac { '.' @digit+ }
  exp  { $[eE] $[+\-]? @digit+ }

  string { '"' char* '"' }
  char { $[\u{20}\u{21}\u{23}-\u{5b}\u{5d}-\u{10ffff}] | "\\" esc }
  esc  { $["\\\/bfnrt] | "u" hex hex hex hex }
  hex  { $[0-9a-fA-F] }

  // {{ anything-but-closing-brace }}
  Variable { "{{" ![}]* "}}" }

  whitespace { $[ \n\r\t] }

  "{" "}" "[" "]"

  @precedence { Variable, "{" }
}

@skip { whitespace }

@detectDelim
